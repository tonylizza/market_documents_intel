POSTGRES_USER=market_documents
POSTGRES_PASSWORD=market_documents
POSTGRES_DB=market_documents
POSTGRES_PORT=5432

DATABASE_URL=postgresql+psycopg://market_documents:market_documents@localhost:5432/market_documents

# Milestone 7A.1: application/publication-layer target database. Must be a
# separate database from DATABASE_URL unless ALLOW_SAME_DATABASE_DEV_MODE=true.
APP_DATABASE_URL=postgresql+psycopg://market_documents:market_documents@localhost:5432/market_documents_app
# ALLOW_SAME_DATABASE_DEV_MODE=true

DATA_RAW_DIR=data/raw
LOG_LEVEL=INFO

# Optional: local path to the Loughran-McDonald Master Dictionary CSV (not
# committed -- see data/reference/financial_language/loughran_mcdonald/README.md).
# LOUGHRAN_MCDONALD_DICTIONARY_PATH=data/reference/financial_language/loughran_mcdonald/1993-2025/Loughran-McDonald_MasterDictionary_1993-2025.csv

# Track 7C.6 rollback switch. false (default): every comparison request
# stays on the legacy passage-alignment pipeline, unconditionally. true:
# additionally routes the exact scope in
# src/market_documents/services/cutover_config.py to the new
# semantic-unit/structured-table pipeline. Toggling requires no
# deployment -- change this and restart. See docs/7c6-production-cutover.md.
# SEMANTIC_COMPARISON_CUTOVER_ENABLED=false
