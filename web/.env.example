# Server-only. Never referenced from a Client Component, never sent to the
# browser. Must be a read-only role connection string (app_readonly) -- see
# ../docs/frontend.md and ../scripts/sql/app_roles.sql. Never DATABASE_URL,
# APP_DATABASE_URL, or publisher credentials.
APP_READONLY_DATABASE_URL=postgresql://app_readonly:CHANGE_ME@localhost:5434/market_documents_app

# Used only by the frontend test suite (repository tests) -- a dedicated
# application test database, never the research database, never publisher
# credentials.
TEST_APP_READONLY_DATABASE_URL=postgresql://app_readonly:CHANGE_ME@localhost:5434/market_documents_app_test

# Milestone 7B.3: selects the query-embedding provider. "local" (default)
# calls the local Python FastAPI service via QUERY_EMBEDDING_SERVICE_URL
# below; "cloudflare" calls Cloudflare Workers AI server-side (production).
QUERY_EMBEDDING_PROVIDER=local

# Local-only ("local" provider). Unreachable from Vercel -- never set in a
# Vercel deployment.
QUERY_EMBEDDING_SERVICE_URL=http://localhost:8081

# Server-only Cloudflare Workers AI credentials ("cloudflare" provider).
# Never referenced from a Client Component.
CLOUDFLARE_ACCOUNT_ID=CHANGE_ME
CLOUDFLARE_API_TOKEN=CHANGE_ME
CLOUDFLARE_EMBEDDING_MODEL=@cf/baai/bge-small-en-v1.5

# Server-only Gemini free-tier credentials. Never referenced from a Client
# Component. See `lib/config/generation-config.ts` for the fallback model
# if unset -- "gemini-2.5-flash-lite" is deprecated (404s as of 2026-08),
# use "gemini-flash-lite-latest" or the repo's currently-configured model.
GEMINI_API_KEY=CHANGE_ME
GEMINI_MODEL=gemini-flash-lite-latest

# Milestone 7B.3 abuse-control daily quota counters (see
# ../scripts/sql/qa_quota.sql). A separate, narrowly-scoped role
# (app_quota_writer) with EXECUTE-only access to one SECURITY DEFINER
# function -- never the app_readonly credential, never a table grant.
# Optional: quota checks fail open (no extra limiting) if unset.
QA_QUOTA_DATABASE_URL=postgresql://app_quota_writer:CHANGE_ME@localhost:5434/market_documents_app
QA_QUOTA_PER_CLIENT_DAILY=10
QA_QUOTA_GLOBAL_DAILY=100
